# bot/.env: everything campaign-specific about the live table.
# Copy this file to bot/.env and fill it in. Never commit bot/.env: it holds the bot's token.
# Comments must sit on their own lines: anything after "=" is read as the value.
# Channel IDs: Discord Developer Mode on, right-click the channel, Copy Channel ID.

# --- required ---------------------------------------------------------------
DISCORD_TOKEN=
# The game room: narration, options, roll gates.
ALLOWED_CHANNEL_ID=
# The voice channel the narrator speaks in.
TTS_VOICE_CHANNEL_ID=

# --- optional rooms ---------------------------------------------------------
# Out-of-character talk.
OOC_CHANNEL_ID=
# Joe only: roll logs, the full LOOP, notes. Unset: those rows are dropped, never posted to the game room.
DM_CHANNEL_ID=
# World dice, posted straight from the dice ledger. Unset: they land in the game room.
DICE_CHANNEL_ID=
# Private per-character rooms: Name:channelid,Name:channelid
BUBBLE_CHANNELS=
GUILD_ID=

# --- who is who -------------------------------------------------------------
# Discord display name to character: discordname:Character,...
PLAYER_MAP=

# --- voices -----------------------------------------------------------------
# Kokoro voice for narration (af_heart if unset; am_michael, bm_george, ... or fit:<name>).
NARRATOR_VOICE=
# Character:voice,... for lines written "Name: what they said".
CHARACTER_VOICES=
# Name:phonetic,... (audio only; the written record never changes).
PRONUNCIATION_OVERRIDES=

# --- paths (rarely needed) --------------------------------------------------
# Default: bot/mailbox/ if that folder exists, else bot/.
MAILBOX_DIR=
# Default: <campaign>/dice/ledger.jsonl
LEDGER_PATH=
